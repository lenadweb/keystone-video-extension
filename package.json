{
  "name": "keystone-video-extension",
  "version": "2.0.2",
  "description": "Perspective correction for browser videos, built for projector setups.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && vite build --config vite.content.config.ts && node scripts/validate-build.mjs",
    "package": "npm run check && npm run build && node scripts/package.mjs",
    "version": "node scripts/sync-version.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:comments": "node scripts/check-comments.mjs",
    "check": "npm run lint && npm run lint:comments && npm run lint:architecture && npm run typecheck && npm test",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/generate-assets.mjs",
    "promo": "npm run build && node scripts/generate-promo.mjs",
    "licenses": "node scripts/generate-notices.mjs",
    "prebuild": "npm run licenses",
    "assets:check": "node scripts/validate-assets.mjs",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "fflate": "^0.8.3",
    "prettier": "^3.8.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "author": "lenadweb",
  "homepage": "https://github.com/lenadweb/keystone-video-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenadweb/keystone-video-extension.git"
  },
  "bugs": {
    "url": "https://github.com/lenadweb/keystone-video-extension/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "keystone",
    "projector",
    "video",
    "perspective-correction"
  ],
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
